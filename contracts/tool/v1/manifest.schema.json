{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xinjiyuan97/mina/contracts/tool/v1/manifest.schema.json",
  "title": "Mina Tool Plugin Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "plugin_name", "plugin_version", "tools"],
  "properties": {
    "protocol_version": { "const": 1 },
    "plugin_name": { "type": "string", "minLength": 1 },
    "plugin_version": { "type": "string", "minLength": 1 },
    "tools": {
      "type": "array",
      "items": { "$ref": "#/$defs/tool" }
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "input_schema"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "input_schema": { "type": "object" },
        "risk_level": {
          "type": "string",
          "enum": ["low", "medium", "high"],
          "default": "low"
        }
      }
    }
  }
}
