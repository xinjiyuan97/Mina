{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xinjiyuan97/mina/contracts/tool/v1/invoke-result.schema.json",
  "title": "Mina Tool Invoke Result v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "content"],
      "properties": {
        "status": { "const": "success" },
        "content": { "type": "string" },
        "structured_content": {}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "error"],
      "properties": {
        "status": { "const": "error" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "retryable"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string" },
            "category": {
              "type": "string",
              "enum": [
                "invalid_request",
                "not_found",
                "permission_denied",
                "conflict",
                "resource_exhausted",
                "timeout",
                "cancelled",
                "unavailable",
                "internal",
                "unknown"
              ]
            },
            "retryable": { "type": "boolean" },
            "retry_after_ms": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  ]
}
